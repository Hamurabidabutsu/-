# demo: 架空のデータ・デモログイン・課金なしの検証用。実利用では live に変更。
APP_MODE=demo
DATA_DIR=./data/demo
STORAGE_BACKEND=sqlite
SITE_URL=http://localhost:3000
# live では paypal が必須。sandbox の決済も実課金のない外部サービス検証用です。
PAYMENT_MODE=demo
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
# live の初回起動時のみ管理者を作成。12文字以上の固有パスワードを安全に設定。
ADMIN_EMAIL=
ADMIN_PASSWORD=
REVIEW_EMAIL=
# on_requestでは個人情報を公開APIに返しません。請求対応用の実情報は本番の秘密設定で管理。
OPERATOR_DISPLAY_MODE=on_request
OPERATOR_TYPE=individual
OPERATOR_REPRESENTATIVE=
OPERATOR_DISCLOSURE_READY=no
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_PHONE=

# Windowsデモはpreviewを強制し、実際のメールを送信しません。
# 本番はsmtpを指定し、SMTP提供元の設定を安全な環境変数で入力します。
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

