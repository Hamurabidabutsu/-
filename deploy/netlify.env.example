# Netlifyの環境変数画面に設定。初回は課金なしの架空データ検証。
STORAGE_BACKEND=netlify
APP_MODE=demo
PAYMENT_MODE=demo
MAIL_MODE=preview
SITE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
REVIEW_EMAIL=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OPERATOR_TYPE=individual
OPERATOR_REPRESENTATIVE=
OPERATOR_DISPLAY_MODE=on_request
OPERATOR_DISCLOSURE_READY=no
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_PHONE=
# NETLIFY_DB_URL等はNetlifyの公式DB機能が管理。Gitへ保存しない。
