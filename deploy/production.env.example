# リポジトリ直下の .env.production.local にコピーし、公開先で実値を設定する。
# 値をチャットへ貼らず、Gitへ登録しない。このファイル自体は空のひな形。
APP_MODE=live
DATA_DIR=/srv/kounotori/data
SITE_URL=
PAYMENT_MODE=paypal
# まずSandboxで検証し、その後liveへ切り替える。
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
REVIEW_EMAIL=
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmailで発行したアプリパスワード。通常のGoogleログインパスワードは使わない。
SMTP_PASSWORD=
MAIL_FROM=
# 一般公開せず、請求者への個別開示に対応する。
OPERATOR_DISPLAY_MODE=on_request
OPERATOR_TYPE=individual
# 法人化後はcompanyに変更し、法人名と運営責任者を設定する。
OPERATOR_REPRESENTATIVE=
OPERATOR_DISCLOSURE_READY=no
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_PHONE=
NEXT_TELEMETRY_DISABLED=1
